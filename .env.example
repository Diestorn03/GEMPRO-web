# Supabase del sitio de GEMPRO (proyecto aparte del de Kindra Project).
# Crear en supabase.com y copiar de Project Settings -> API.
SUPABASE_URL=
# service_role: solo se usa en el servidor (rutas /api/*), nunca llega al navegador.
SUPABASE_SERVICE_KEY=

# Sesión del panel privado de GEMPRO (/panel) y del portal de clientes.
ADMIN_PASSWORD=
AUTH_SECRET=

# Obligatoria en Vercel: /api/latido (cron diario) solo acepta la llamada firmada por Vercel; sin
# ella responde 503 en vez de quedar abierto a cualquiera. Vercel la genera sola al guardarla ahí;
# no hace falta elegir un valor a mano ni ponerla en local.
CRON_SECRET=

# Opcional: a qué correo llega el aviso de cada consulta del formulario. Sin definir, va al correo
# de GEMPRO (site.email en src/data/site.ts). Útil para desviarlo a un correo de pruebas.
CORREO_AVISOS=

# Opcional: sin estas dos, el formulario de contacto sigue guardando la consulta en Supabase
# igual que siempre, pero no se envía el aviso por correo. Cuenta de Gmail dedicada (no hace
# falta Google Workspace, una cuenta gratis alcanza): activar verificación en dos pasos en
# myaccount.google.com/security, luego generar una "contraseña de aplicación" en
# myaccount.google.com/apppasswords — esa es GMAIL_APP_PASSWORD, no la contraseña normal de la
# cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=
