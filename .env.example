# Supabase del sitio de GEMPRO (proyecto aparte del de Kindra Project).
# Crear en supabase.com y copiar de Project Settings -> API.
SUPABASE_URL=
# service_role: solo se usa en el servidor (rutas /api/*), nunca llega al navegador.
SUPABASE_SERVICE_KEY=

# Sesión del panel privado de GEMPRO (/panel) y del portal de clientes.
ADMIN_PASSWORD=
AUTH_SECRET=

# Opcional: si se pone en Vercel, /api/latido (cron diario) solo acepta la llamada firmada
# por Vercel y ya no responde a cualquiera. Vercel la genera sola al guardarla ahí; no hace
# falta elegir un valor a mano ni ponerla en local.
CRON_SECRET=
