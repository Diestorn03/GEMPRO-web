---
import { site } from '../data/site';
---
<div class="fixed inset-x-0 bottom-0 z-40 flex gap-2.5 border-t border-white/10 bg-[#040f1e]/92 px-4 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 backdrop-blur-lg md:hidden" role="region" aria-label="Contacto rápido">
  <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="flex h-12 flex-1 items-center justify-center gap-2 rounded-[3px] border border-neon text-[13px] font-bold uppercase tracking-[0.06em] text-white">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3ddc84" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.3 7.9L3 21l1.1-4.7A9 9 0 1 1 21 12z"/></svg>
    WhatsApp
  </a>
  <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="flex h-12 flex-1 items-center justify-center gap-2 rounded-[3px] bg-green text-[13px] font-extrabold uppercase tracking-[0.06em] text-ink">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6.2 6.2l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    Llamar
  </a>
</div>
