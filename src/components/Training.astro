---
import { Image } from 'astro:assets';
import { training } from '../data/site';
import fotoCapacitacion from '../assets/img/adiestramiento-capacitacion.jpg';
---
<section id="adiestramiento" class="grid lg:grid-cols-2 lg:min-h-[720px]">
  <div class="relative min-h-[360px] overflow-hidden lg:min-h-0" data-parallax-scope>
    <div class="absolute inset-0" data-parallax="10">
      <Image src={fotoCapacitacion} alt="" widths={[640, 900, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" class="h-full w-full object-cover" loading="lazy" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,20,38,.15)_30%,rgba(6,20,38,.8)_100%)]" aria-hidden="true"></div>
    <div class="absolute bottom-8 left-6 flex flex-col gap-1 lg:bottom-11 lg:left-12" data-reveal="left">
      <span class="display text-[64px] text-white lg:text-[96px]">Nivel</span>
      <span class="display text-[64px] text-neon lg:text-[96px]">I · II · III</span>
    </div>
  </div>

  <div class="flex flex-col justify-center gap-5 bg-panel px-5 py-14 sm:px-8 lg:px-[72px] lg:py-16">
    <span class="eyebrow" data-reveal="fade">Adiestramiento</span>
    <h2 class="display text-[clamp(32px,4vw,44px)] text-white" data-split>{training.title}</h2>
    <p class="text-[16px] leading-relaxed text-mist lg:text-[17px]" data-reveal data-delay="0.15">{training.text}</p>
    <ul class="mt-2 border-t border-white/10" data-reveal-group data-stagger="0.08">
      {training.courses.map((c) => (
        <li class="grid grid-cols-[64px_1fr_auto] items-center gap-4 border-b border-white/10 py-3.5">
          <span class="font-mono text-[12px] text-neon">{c.code}</span>
          <span class="text-[15px] text-white lg:text-[16px]">{c.name}</span>
          <span class="font-mono text-[12px] text-mist">{c.date}</span>
        </li>
      ))}
    </ul>
    <a href="#contacto" class="mt-1 self-start border-b-2 border-neon pb-1 text-[14px] font-bold uppercase tracking-[0.08em] text-white transition-colors hover:text-neon" data-reveal="fade" data-delay="0.3">Solicitar el programa</a>
  </div>
</section>
