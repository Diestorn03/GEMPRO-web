---
import { Picture } from 'astro:assets';
import fotoControl from '../assets/img/hero-slide-1.jpg';
import { hero } from '../data/site';
---
<section id="inicio" class="relative isolate flex min-h-[720px] flex-col justify-end overflow-hidden bg-ink lg:min-h-[900px]" data-parallax-scope>
  <!-- Fotografía con zoom lento y parallax -->
  <div class="hero-photo absolute inset-0 -z-20" data-parallax="14">
    <Picture
      src={fotoControl}
      formats={['avif', 'webp']}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[60%_40%]"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(6,20,38,.96)_0%,rgba(6,20,38,.78)_40%,rgba(6,20,38,.35)_75%,rgba(6,20,38,.55)_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(6,20,38,.45)_0%,rgba(6,20,38,0)_30%,rgba(6,20,38,0)_55%,#061426_100%)]"></div>

  <div class="container-x relative grid gap-10 pb-40 pt-40 lg:grid-cols-[1fr_360px] lg:items-start lg:gap-16 lg:pb-52 lg:pt-56">
    <!-- Copy -->
    <div class="flex min-w-0 max-w-[900px] flex-col gap-6 lg:gap-7">
      <div class="flex items-center gap-3.5" data-reveal="fade" data-delay="0.1">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="eyebrow">{hero.eyebrow}</span>
      </div>
      <!-- El titular entra con CSS puro: se pinta de inmediato (no espera a JS ni a la fuente) -->
      <h1 class="display text-[clamp(36px,8vw,92px)] text-white">
        {hero.lines.map((line, i) => (
          <span class="hero-line block overflow-hidden pb-[0.06em] -mb-[0.06em]">
            <span class:list={['hero-line-inner block', { 'text-neon': i === hero.lines.length - 1 }]} style={`--i:${i}`}>{line}</span>
          </span>
        ))}
      </h1>
      <p class="max-w-[560px] text-[17px] leading-relaxed text-fog lg:text-[21px]" data-reveal data-delay="0.55">{hero.text}</p>
      <div class="flex flex-col gap-3.5 sm:flex-row sm:gap-4" data-reveal data-delay="0.7">
        <a href={hero.primary.href} class="btn-primary" data-magnetic>{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn-ghost">{hero.secondary.label}</a>
      </div>
    </div>

    <!-- Panel de lectura (HUD) -->
    <aside class="hud relative hidden flex-col gap-5 rounded-md border border-neon/35 bg-ink/60 p-6 backdrop-blur-md lg:mt-28 lg:flex" data-reveal="right" data-delay="0.85" aria-label="Ejemplo de lectura de vibración">
      <div class="flex items-center justify-between gap-3">
        <span class="eyebrow">{hero.hud.title}</span>
        <span class="font-mono text-[11px] text-mist">{hero.hud.demo}</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-mono text-[12px] tracking-[0.08em] text-mist">{hero.hud.asset}</span>
        <div class="flex items-baseline gap-2.5">
          <span class="display text-[64px] leading-none text-white tabular-nums" data-hud-value>{hero.hud.value.toFixed(1).replace('.', ',')}</span>
          <span class="font-mono text-[14px] text-fog">{hero.hud.unit}</span>
        </div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-white/10">
          <div class="h-full rounded-full bg-[linear-gradient(90deg,#28af60,#ffb454)]" data-hud-bar style="width: 64%"></div>
        </div>
        <div class="flex justify-between font-mono text-[10px] text-mist"><span>BUENO</span><span class="text-amber">ALERTA</span><span>PARADA</span></div>
      </div>
      <div class="grid grid-cols-2 gap-3 font-mono">
        <div class="flex flex-col gap-0.5 border-l-2 border-white/15 pl-2.5"><span class="text-[10px] tracking-[0.1em] text-mist">1X</span><span class="text-[16px] text-white">{hero.hud.freq}</span></div>
        <div class="flex flex-col gap-0.5 border-l-2 border-white/15 pl-2.5"><span class="text-[10px] tracking-[0.1em] text-mist">RODAMIENTO</span><span class="text-[16px] text-white">{hero.hud.temp}</span></div>
      </div>
      <div class="flex items-center gap-2.5 rounded border border-amber/40 bg-amber/10 px-3 py-2.5">
        <span class="h-2 w-2 rounded-full bg-amber" aria-hidden="true"></span>
        <span class="font-mono text-[12px] text-[#ffd9a3]">{hero.hud.alert}</span>
      </div>
    </aside>
  </div>

  <!-- Onda de vibración que se dibuja -->
  <svg class="pointer-events-none absolute bottom-16 left-0 h-[120px] w-full lg:bottom-[70px] lg:h-[160px]" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <path data-draw="2.8" d="M0,110 C60,110 80,104 120,96 S180,84 220,98 S280,124 320,96 S380,20 420,60 S470,132 520,100 S580,60 620,84 S690,120 740,72 S800,10 850,68 S910,128 960,96 S1020,60 1080,88 S1150,116 1200,80 S1260,40 1310,72 S1390,110 1440,96" fill="none" stroke="#3ddc84" stroke-width="2.5" stroke-linecap="round" />
    <path d="M0,110 C60,110 80,104 120,96 S180,84 220,98 S280,124 320,96 S380,20 420,60 S470,132 520,100 S580,60 620,84 S690,120 740,72 S800,10 850,68 S910,128 960,96 S1020,60 1080,88 S1150,116 1200,80 S1260,40 1310,72 S1390,110 1440,96 L1440,160 L0,160 Z" fill="rgba(61,220,132,.08)" />
  </svg>

  <div class="container-x absolute inset-x-0 bottom-7 flex items-center justify-between font-mono text-[11px] tracking-[0.2em] text-mist lg:bottom-9" data-reveal="fade" data-delay="1.2">
    <a href="#servicios" class="flex items-center gap-3.5 transition-colors hover:text-neon"><span>DESPLÁCESE</span><span class="block h-px w-14 bg-neon"></span></a>
    <ul class="hidden gap-7 sm:flex" aria-label="Sedes"><li>VE</li><li>AR</li><li>PE</li><li>PA</li></ul>
  </div>
</section>

<style>
  .hero-photo img { animation: ken-burns 8s var(--ease-out-quart) both; transform-origin: 60% 40%; }
  @keyframes ken-burns { from { scale: 1.12; } to { scale: 1; } }
  .hero-line-inner { animation: line-up 1.1s var(--ease-out-expo) both; animation-delay: calc(0.15s + var(--i) * 0.12s); }
  @keyframes line-up { from { transform: translateY(110%); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero-photo img, .hero-line-inner { animation: none; } }
</style>

<script>
  import gsap from 'gsap';
  // Lectura de demostración: el valor oscila suavemente para que el panel se sienta vivo.
  function hudDemo() {
    const el = document.querySelector<HTMLElement>('[data-hud-value]');
    const bar = document.querySelector<HTMLElement>('[data-hud-bar]');
    if (!el || !bar) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const state = { v: 4.6 };
    let timer = 0;
    const tick = () => {
      const next = 4.3 + Math.random() * 0.7;
      gsap.to(state, {
        v: next, duration: 1.4, ease: 'sine.inOut',
        onUpdate: () => {
          el.textContent = state.v.toFixed(1).replace('.', ',');
          bar.style.width = `${Math.round(40 + (state.v - 3.5) * 24)}%`;
        },
      });
      timer = window.setTimeout(tick, 1800 + Math.random() * 1200);
    };
    timer = window.setTimeout(tick, 1500);
    document.addEventListener('astro:before-swap', () => clearTimeout(timer), { once: true });
  }
  document.addEventListener('astro:page-load', hudDemo);
</script>
