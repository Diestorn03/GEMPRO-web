---
import { Image } from 'astro:assets';
import PanelBase from '../layouts/PanelBase.astro';
import fotoFondo from '../assets/img/hero-slide-2.jpg';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
---
<PanelBase title="Entrar">
  <nav slot="nav"></nav>
  <section class="relative -mx-6 -my-10 isolate overflow-hidden lg:-my-14" data-parallax-scope>
    <div class="absolute inset-0 -z-20" data-parallax="10">
      <Image src={fotoFondo} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="h-full w-full object-cover" loading="eager" />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(6,20,38,.97)_0%,rgba(6,20,38,.88)_45%,rgba(6,20,38,.6)_100%)]" aria-hidden="true"></div>
    <div class="container-x flex min-h-[calc(100dvh-73px)] items-center py-16">
      <form method="post" action="/api/entrar" data-ajax data-reveal="up" class="w-full max-w-md rounded-md border border-white/15 bg-white/[0.06] p-8 backdrop-blur-xl lg:p-10">
        <span class="eyebrow">Panel privado</span>
        <h1 class="display mt-3 text-[clamp(30px,4vw,40px)] text-white" data-split>Acceso del equipo</h1>
        <p class="mb-7 mt-2 text-[14px] text-fog">Solo para GEMPRO.</p>
        {error && <p class="mb-4 rounded border border-amber/40 bg-amber/10 px-3 py-2 text-[13px] text-amber" role="alert">Contraseña incorrecta.</p>}
        <label for="password" class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog">Contraseña</label>
        <div class="relative mb-5">
          <input id="password" name="password" type="password" required autofocus class="field pr-12" autocomplete="current-password" />
          <button type="button" id="ver-contrasena" aria-label="Mostrar contraseña" class="absolute right-2 top-1/2 -translate-y-1/2 rounded p-2 text-mist transition-colors hover:text-white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
          </button>
        </div>
        <button type="submit" class="btn-primary h-[54px] w-full" data-magnetic>Entrar</button>
      </form>
    </div>
  </section>
</PanelBase>

<script>
  function setup() {
    const boton = document.getElementById('ver-contrasena');
    const campo = document.getElementById('password') as HTMLInputElement | null;
    if (!boton || !campo || boton.dataset.listo) return;
    boton.dataset.listo = '1';
    boton.addEventListener('click', () => {
      const ver = campo.type === 'password';
      campo.type = ver ? 'text' : 'password';
      boton.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
