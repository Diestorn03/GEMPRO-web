---
import Panel from '../../layouts/Panel.astro';
import { estaAutenticado } from '../../lib/auth';
import { sb } from '../../lib/supabase';

export const prerender = false;

if (!estaAutenticado(Astro.cookies)) return Astro.redirect('/entrar', 303);

const { data: noticias } = await sb().from('noticias').select('*').order('creado_en', { ascending: false });
const editarId = Astro.url.searchParams.get('editar');
const nueva = Astro.url.searchParams.get('nueva');
const error = Astro.url.searchParams.get('error');
const editando = editarId ? (noticias ?? []).find((n) => n.id === editarId) : null;
const mostrarForm = Boolean(editando || nueva || (noticias ?? []).length === 0);
const fecha = (iso: string) => new Date(iso).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Panel title="Noticias" seccion="noticias" eyebrow="Blog" encabezado="Lo que GEMPRO quiere contar." descripcion="Título, artículo y una foto. Al guardar aparece en el sitio público de inmediato; si la ocultas, desaparece sin borrarse.">
  <a slot="acciones" href="/noticias" target="_blank" class="btn-ghost border border-white/15 px-4 py-2.5 text-[13px]">Ver como visitante ↗</a>
  {!mostrarForm && <a slot="acciones" href="/panel/noticias?nueva=1" class="btn-primary px-5 py-2.5 text-[13px]">＋ Nueva noticia</a>}

  {mostrarForm && (
    <form method="post" action="/api/panel/noticias" enctype="multipart/form-data" data-ajax data-reveal class="mb-10 grid gap-4 rounded-md border border-white/10 bg-panel p-6 lg:grid-cols-[1fr_300px] lg:p-8">
      <div class="lg:col-span-2">
        <span class="eyebrow">{editando ? 'Editar noticia' : 'Nueva noticia'}</span>
        {error === '1' && <p class="mt-2 text-[13px] text-amber" role="alert">Falta el título o el contenido.</p>}
      </div>
      {editando && <input type="hidden" name="id" value={editando.id} />}
      <input type="hidden" name="imagen_actual" value={editando?.imagen_url ?? ''} />
      <div class="grid gap-4">
        <div>
          <label class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog" for="titulo">Título</label>
          <input name="titulo" id="titulo" required class="field text-[18px] font-semibold" placeholder="Título de la noticia" value={editando?.titulo} />
        </div>
        <div>
          <label class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog" for="contenido">Artículo</label>
          <textarea name="contenido" id="contenido" required rows={12} class="field leading-relaxed" placeholder="Escriba el artículo completo. Deje una línea en blanco entre párrafos.">{editando?.contenido}</textarea>
        </div>
      </div>
      <div class="grid content-start gap-4">
        <div>
          <label class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog" for="imagen">Foto {editando?.imagen_url && '(suba otra para cambiarla)'}</label>
          <input type="file" name="imagen" id="imagen" accept="image/*" class="field text-[13px]" />
          {editando?.imagen_url && <img src={editando.imagen_url} alt="" class="mt-3 aspect-[16/10] w-full rounded object-cover" />}
        </div>
        <label class="flex items-center gap-2 text-[14px] text-white"><input type="checkbox" name="publicado" checked={editando ? editando.publicado : true} class="h-4 w-4 accent-neon" /> Visible en el sitio público</label>
        <div class="flex gap-2">
          <button type="submit" class="btn-primary" data-magnetic>Guardar</button>
          <a href="/panel/noticias" class="btn-ghost border border-white/15">Cancelar</a>
        </div>
      </div>
    </form>
  )}

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group data-stagger="0.08">
    {(noticias ?? []).map((n) => (
      <article class="group flex flex-col overflow-hidden rounded-md border border-white/10 bg-panel transition-[border-color,transform] duration-500 hover:-translate-y-1.5 hover:border-neon/50">
        <div class="h-[160px] overflow-hidden bg-white/5">
          {n.imagen_url && <img src={n.imagen_url} alt="" class="h-full w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105" />}
        </div>
        <div class="flex flex-1 flex-col gap-2 p-5">
          <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-neon">{fecha(n.creado_en)}{!n.publicado && <span class="text-amber"> · oculta</span>}</span>
          <p class="display text-[19px] leading-tight text-white">{n.titulo}</p>
          <div class="mt-auto flex gap-2 pt-3 text-[13px]">
            <a href={`/panel/noticias?editar=${n.id}`} class="btn-ghost border border-white/15 px-3 py-1.5">Editar</a>
            <a href={`/noticias/${n.id}`} target="_blank" class="btn-ghost border border-white/15 px-3 py-1.5">Ver ↗</a>
            <form method="post" action="/api/panel/noticias" data-ajax data-confirmar="¿Eliminar esta noticia?">
              <input type="hidden" name="_accion" value="eliminar" />
              <input type="hidden" name="id" value={n.id} />
              <input type="hidden" name="imagen_url" value={n.imagen_url ?? ''} />
              <button type="submit" class="btn-ghost border border-white/15 px-3 py-1.5 text-amber">Eliminar</button>
            </form>
          </div>
        </div>
      </article>
    ))}
  </div>
</Panel>
