---
import { qrPngCacheado } from '../../lib/qr';
import Panel from '../../layouts/Panel.astro';
import { estaAutenticado } from '../../lib/auth';
import { sb } from '../../lib/supabase';
import { aLocal, eventoAbierto, eventoActual } from '../../lib/evento';
import { fechaHoraVE } from '../../lib/fechas';
import { origenPublico } from '../../data/site';

export const prerender = false;

if (!estaAutenticado(Astro.cookies)) return Astro.redirect('/entrar', 303);

interface Evento { id: string; nombre: string; inicio: string | null; fin: string | null; forzar_abierto: boolean | null; creado_en: string }
const [{ data: eventosData }, { data: registros }] = await Promise.all([
  sb().from('eventos').select('*').order('creado_en', { ascending: false }),
  sb().from('registro_evento').select('evento_id'),
]);
const eventos = (eventosData ?? []) as Evento[];
// Conteo por evento en JS: una consulta ligera en vez de una por evento.
const conteo: Record<string, number> = {};
for (const r of registros ?? []) conteo[r.evento_id] = (conteo[r.evento_id] ?? 0) + 1;
const actual = eventoActual(eventos);
const abierto = eventoAbierto(actual);
const abiertos = eventos.filter(eventoAbierto);
const historial = eventos.filter((e) => e.id !== actual?.id);
const registrosDe = (e: Evento) => conteo[e.id] ?? 0;
const forzarDe = (e: Evento | null) => (e?.forzar_abierto === true ? 'abierto' : e?.forzar_abierto === false ? 'cerrado' : 'auto');
const rango = (e: Evento) => (e.inicio && e.fin ? `${fechaHoraVE(e.inicio)} → ${fechaHoraVE(e.fin)}` : 'sin fechas');

const p = Astro.url.searchParams;
const aviso = p.get('guardado') ? 'Evento guardado.' : p.get('creado') ? 'Evento creado.' : p.get('eliminado') ? 'Evento eliminado junto con sus registros.' : '';
const error = p.get('error') === '1';

const urlEvento = `${origenPublico(Astro.url.origin)}/evento`;
const [qrGempro, qrClasico] = await Promise.all([qrPngCacheado(urlEvento, 'gempro', 480), qrPngCacheado(urlEvento, 'clasico', 480)]);
const dataUrl = (b: Buffer) => 'data:image/png;base64,' + b.toString('base64');
const campo = 'mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog';
const botonQr = 'btn-ghost border border-white/15 px-3 py-2.5 text-center text-[12px]';
---
<Panel title="Eventos" seccion="evento" eyebrow="Registro por QR" encabezado="Un código, todos los eventos." descripcion="El QR es permanente: apunta siempre a la página de registro. Cada evento tiene sus fechas, sus registros, su CSV y su sorteo; los anteriores quedan en el historial.">
  <span slot="acciones" class:list={['inline-flex items-center gap-2 rounded-full border px-4 py-2 text-[12px] font-bold uppercase tracking-[0.1em]', abierto ? 'border-neon/50 text-neon' : 'border-amber/50 text-amber']}>
    <span class:list={['h-2 w-2 rounded-full', abierto ? 'bg-neon' : 'bg-amber']} aria-hidden="true"></span>{abierto ? `Registro abierto: ${actual!.nombre}` : 'Ningún evento activo'}
  </span>

  {aviso && <p class="mb-6 rounded-md border border-neon/40 bg-neon/10 px-4 py-3 text-[14px] text-white" data-reveal="fade">{aviso}</p>}
  {error && <p class="mb-6 rounded-md border border-amber/40 bg-amber/10 px-4 py-3 text-[14px] text-amber" role="alert">Revisa los datos: hace falta nombre, fecha de apertura y de cierre, y el cierre debe ser después de la apertura.</p>}
  {abiertos.length > 1 && <p class="mb-6 rounded-md border border-amber/40 bg-amber/10 px-4 py-3 text-[14px] text-amber" role="alert">Hay {abiertos.length} eventos abiertos a la vez; el QR registra en «{actual!.nombre}». Cierra los demás para evitar confusiones.</p>}

  <div class="grid min-w-0 gap-6 lg:grid-cols-[1fr_340px]" data-reveal-group data-stagger="0.1">
    <div class="grid min-w-0 gap-6">
      {actual ? (
        <div class="grid min-w-0 gap-5 rounded-md border border-white/10 bg-panel p-6 lg:p-8" data-tarjeta>
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="eyebrow">{abierto ? 'Evento en curso' : 'Último evento (cerrado)'}</span>
              <h2 class="display mt-2 text-[24px] text-white">{actual.nombre}</h2>
              <p class="mt-1 font-mono text-[12px] text-mist">{rango(actual)}</p>
            </div>
            <div class="text-right">
              <span class="display block text-[44px] leading-none text-neon tabular-nums" data-count={registrosDe(actual)}>{registrosDe(actual)}</span>
              <span class="text-[12px] font-semibold uppercase tracking-[0.1em] text-mist">registros</span>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class={botonQr} data-csv data-evento={actual.id} data-nombre={actual.nombre}>Exportar CSV</button>
            <button type="button" class="btn-primary px-4 py-2.5 text-[13px]" data-ganador data-evento={actual.id}>Elegir ganador</button>
          </div>
          <p class="hidden rounded-md border border-neon/40 bg-neon/10 px-4 py-3 text-[15px] text-white" data-resultado></p>

          <form method="post" action="/api/panel/evento" data-ajax class="grid min-w-0 gap-4 border-t border-white/10 pt-5 sm:grid-cols-2">
            <input type="hidden" name="_accion" value="guardar" />
            <input type="hidden" name="id" value={actual.id} />
            <div class="sm:col-span-2">
              <label class={campo} for="nombre">Nombre del evento</label>
              <input name="nombre" id="nombre" value={actual.nombre} required class="field" />
            </div>
            <div class="min-w-0">
              <label class={campo} for="inicio">Abre (hora de Venezuela)</label>
              <input type="datetime-local" name="inicio" id="inicio" value={aLocal(actual.inicio)} data-bloqueado={abierto ? 'true' : 'false'} class="campo-fecha field w-full min-w-0" />
              {abierto && <p class="mt-1.5 text-[12px] text-mist">El evento ya está en curso: solo se puede cambiar el cierre.</p>}
            </div>
            <div class="min-w-0">
              <label class={campo} for="fin">Cierra (hora de Venezuela)</label>
              <input type="datetime-local" name="fin" id="fin" value={aLocal(actual.fin)} class="campo-fecha field w-full min-w-0" />
            </div>
            <div class="sm:col-span-2">
              <span class={campo}>Interruptor manual</span>
              <div class="grid grid-cols-3 gap-1.5" role="radiogroup" aria-label="Interruptor manual">
                <label class="segmento"><input type="radio" name="forzar" value="auto" autocomplete="off" class="sr-only" checked={forzarDe(actual) === 'auto'} /> Automático</label>
                <label class="segmento"><input type="radio" name="forzar" value="abierto" autocomplete="off" class="sr-only" checked={forzarDe(actual) === 'abierto'} /> Forzar abierto</label>
                <label class="segmento"><input type="radio" name="forzar" value="cerrado" autocomplete="off" class="sr-only" checked={forzarDe(actual) === 'cerrado'} /> Forzar cerrado</label>
              </div>
              {forzarDe(actual) !== 'auto' && (
                <p class="mt-2 rounded-md border border-amber/40 bg-amber/10 px-3 py-2 text-[13px] text-amber" role="alert">
                  {forzarDe(actual) === 'abierto' ? 'Forzado abierto: ' : 'Forzado cerrado: '}
                  las fechas de arriba no tienen efecto mientras este interruptor no esté en "Automático".
                </p>
              )}
            </div>
            <button type="submit" class="btn-primary self-start sm:col-span-2" data-magnetic>Guardar</button>
          </form>
        </div>
      ) : (
        <p class="rounded-md border border-dashed border-white/15 p-10 text-center text-mist">Todavía no hay eventos. Crea el primero aquí abajo.</p>
      )}

      <form method="post" action="/api/panel/evento" data-ajax class="grid min-w-0 gap-4 rounded-md border border-white/10 bg-panel p-6 sm:grid-cols-2 lg:p-8">
        <input type="hidden" name="_accion" value="crear" />
        <div class="sm:col-span-2"><span class="eyebrow">Nuevo evento</span><h2 class="display mt-2 text-[24px] text-white">Programar el siguiente</h2></div>
        <div class="sm:col-span-2">
          <label class={campo} for="nuevo-nombre">Nombre</label>
          <input name="nombre" id="nuevo-nombre" required class="field" placeholder="Feria Industrial 2026" />
        </div>
        <div class="min-w-0">
          <label class={campo} for="nuevo-inicio">Abre (hora de Venezuela)</label>
          <input type="datetime-local" name="inicio" id="nuevo-inicio" required class="campo-fecha field w-full min-w-0" />
        </div>
        <div class="min-w-0">
          <label class={campo} for="nuevo-fin">Cierra (hora de Venezuela)</label>
          <input type="datetime-local" name="fin" id="nuevo-fin" required class="campo-fecha field w-full min-w-0" />
        </div>
        <button type="submit" class="btn-ghost self-start border border-white/15 sm:col-span-2">Crear evento</button>
      </form>

      <div class="rounded-md border border-white/10 bg-panel p-6 lg:p-8">
        <span class="eyebrow">Historial</span>
        <h2 class="display mb-4 mt-2 text-[24px] text-white">Eventos anteriores</h2>
        {historial.length === 0 ? (
          <p class="rounded-md border border-dashed border-white/15 p-8 text-center text-[14px] text-mist">Cuando termine el evento actual y crees el siguiente, el anterior aparecerá aquí con sus registros, su CSV y su sorteo.</p>
        ) : (
          <div class="grid gap-3">
            {historial.map((e) => (
              <div class="grid gap-3 rounded-md border border-white/10 bg-ink/40 p-4 sm:grid-cols-[1fr_auto] sm:items-center" data-tarjeta>
                <div class="min-w-0">
                  <p class="truncate text-[16px] font-semibold text-white">{e.nombre} <span class:list={['ml-2 text-[11px] font-bold uppercase tracking-[0.1em]', eventoAbierto(e) ? 'text-neon' : 'text-mist']}>{eventoAbierto(e) ? 'abierto' : 'cerrado'}</span></p>
                  <p class="font-mono text-[12px] text-mist">{rango(e)} · <span class="text-white">{registrosDe(e)}</span> registro{registrosDe(e) === 1 ? '' : 's'}</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button type="button" class="btn-ghost border border-white/15 px-3 py-2 text-[12px]" data-csv data-evento={e.id} data-nombre={e.nombre}>CSV</button>
                  <button type="button" class="btn-ghost border border-white/15 px-3 py-2 text-[12px]" data-ganador data-evento={e.id}>Ganador</button>
                  <form method="post" action="/api/panel/evento" data-ajax data-confirmar={`¿Eliminar «${e.nombre}» y sus ${registrosDe(e)} registros?`}>
                    <input type="hidden" name="_accion" value="eliminar" />
                    <input type="hidden" name="id" value={e.id} />
                    <button type="submit" class="btn-ghost border border-white/15 px-3 py-2 text-[12px] text-amber">Eliminar</button>
                  </form>
                </div>
                <p class="hidden rounded-md border border-neon/40 bg-neon/10 px-4 py-2 text-[14px] text-white sm:col-span-2" data-resultado></p>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="flex flex-col gap-4 rounded-md border border-white/10 bg-panel p-6">
      <span class="eyebrow">Código QR permanente</span>
      <p class="break-all font-mono text-[12px] text-neon">{urlEvento}</p>
      <div class="grid gap-3">
        <img src={dataUrl(qrGempro)} alt="QR estilo GEMPRO" class="w-full rounded" />
        <div class="grid grid-cols-2 gap-2">
          <a href="/api/panel/qr?formato=png&estilo=gempro" class={botonQr}>Estilo GEMPRO · PNG</a>
          <a href="/api/panel/qr?formato=svg&estilo=gempro" class={botonQr}>Estilo GEMPRO · SVG</a>
        </div>
      </div>
      <div class="grid gap-3 border-t border-white/10 pt-4">
        <img src={dataUrl(qrClasico)} alt="QR clásico" class="w-full rounded" />
        <div class="grid grid-cols-2 gap-2">
          <a href="/api/panel/qr?formato=png&estilo=clasico" class={botonQr}>Clásico · PNG</a>
          <a href="/api/panel/qr?formato=svg&estilo=clasico" class={botonQr}>Clásico · SVG</a>
        </div>
      </div>
      <p class="text-[12px] leading-relaxed text-mist">PNG: 2400 px, 20 cm a 300 dpi, listo para imprimir. SVG: vectorial para la imprenta (no se previsualiza en el teléfono, es normal). El clásico es la versión de máxima compatibilidad.</p>
    </div>
  </div>
</Panel>

<script>
  function setup() {
    const raiz = document.querySelector<HTMLElement>('main');
    if (!raiz || raiz.dataset.eventosListo) return;
    raiz.dataset.eventosListo = '1';

    const traer = async (evento: string) => {
      const res = await fetch(`/api/panel/evento?evento=${evento}`);
      if (res.status === 401) { location.href = '/entrar'; throw new Error('Sesión vencida'); }
      if (!res.ok) throw new Error(`Respuesta ${res.status}`);
      return res.json();
    };
    // Celdas que empiezan por = + - @ se prefijan con ' para que Excel no las ejecute como fórmula.
    const celda = (v: unknown) => { const s = String(v ?? ''); return `"${(/^[=+\-@]/.test(s) ? "'" + s : s).replace(/"/g, '""')}"`; };
    const fechaVE = (iso: string) => new Date(iso).toLocaleString('es-VE', { timeZone: 'America/Caracas' });

    raiz.addEventListener('click', async (ev) => {
      const boton = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-csv], button[data-ganador]');
      if (!boton) return;
      const evento = boton.dataset.evento!;
      const resultado = boton.closest('[data-tarjeta]')?.querySelector<HTMLElement>('[data-resultado]');
      boton.disabled = true;
      try {
        const registros = await traer(evento);
        if ('csv' in boton.dataset) {
          const filas = [['Nombre', 'Correo', 'Teléfono', 'Fecha (Venezuela)'], ...registros.map((r: any) => [r.nombre, r.correo, r.telefono ?? '', fechaVE(r.creado_en)])];
          const csv = filas.map((f: unknown[]) => f.map(celda).join(',')).join('\n');
          const a = document.createElement('a');
          a.href = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }));
          a.download = `registro-${(boton.dataset.nombre || 'evento').replace(/[^\w\-]+/g, '-')}.csv`;
          a.click();
        } else if (resultado) {
          const g = registros[Math.floor(Math.random() * registros.length)];
          resultado.textContent = g ? `🎉 Ganador: ${g.nombre} — ${g.correo}` : 'Este evento no tiene registros.';
          resultado.classList.remove('hidden');
        }
      } finally { boton.disabled = false; }
    });
  }

  /**
   * Selector de fecha y hora propio (calendario con la marca) en vez del nativo de datetime-local:
   * en Android ese selector no lo pinta la página, lo pinta un diálogo NATIVO del sistema
   * (Chromium se lo delega vía JNI); en Xiaomi/Redmi (MIUI/HyperOS) sale re-vestido con el tema
   * del fabricante — fondo claro, texto casi invisible — y ningún CSS lo alcanza. Con el
   * calendario propio se ve igual en todos los dispositivos. El input original se queda en el
   * DOM, sr-only, y sigue mandando el mismo texto "AAAA-MM-DDTHH:MM": cero cambios en el
   * backend ni en aLocal/aIso. Cada elección (día, hora, minuto) escribe al instante.
   */
  function setupCamposFecha() {
    const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
    const MESES_LARGO = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const SEMANA = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
    const dd = (n: number) => String(n).padStart(2, '0');
    const diasEnMes = (mes: number, anio: number) => new Date(anio, mes, 0).getDate(); // mes 1-12
    const primerDiaSemana = (mes: number, anio: number) => (new Date(anio, mes - 1, 1).getDay() + 6) % 7; // lunes = 0
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase: string, texto = ''): HTMLElementTagNameMap[K] => {
      const e = document.createElement(tag);
      e.className = clase;
      if (texto) e.textContent = texto;
      return e;
    };
    const opcion = (valor: string, texto: string) => { const o = document.createElement('option'); o.value = valor; o.textContent = texto; return o; };
    const crearSelect = (etiqueta: string) => {
      const s = document.createElement('select');
      s.className = 'field !bg-none !px-2 !py-2.5 text-center text-[13px] flex-1';
      s.setAttribute('aria-label', etiqueta);
      // El navegador móvil a veces restaura el valor de la visita anterior por encima del real.
      s.autocomplete = 'off';
      return s;
    };
    const cerrarTodos = () => {
      document.querySelectorAll<HTMLElement>('.fecha-panel:not([hidden])').forEach((p) => {
        p.hidden = true;
        p.previousElementSibling?.setAttribute('aria-expanded', 'false');
      });
    };

    document.querySelectorAll<HTMLInputElement>('input.campo-fecha').forEach((input) => {
      if (input.dataset.mejorado) return;
      input.dataset.mejorado = '1';
      input.classList.add('sr-only');
      input.tabIndex = -1;
      input.setAttribute('aria-hidden', 'true');
      input.style.pointerEvents = 'none';

      const hoy = new Date();
      const v = input.value;
      const estado = v
        ? { anio: Number(v.slice(0, 4)), mes: Number(v.slice(5, 7)), dia: Number(v.slice(8, 10)), hora: Number(v.slice(11, 13)), min: Number(v.slice(14, 16)) }
        : { anio: hoy.getFullYear(), mes: hoy.getMonth() + 1, dia: hoy.getDate(), hora: 12, min: 0 };
      // Mes que se está mirando en el calendario (puede ser distinto al elegido mientras se navega).
      let vista = { anio: estado.anio, mes: estado.mes };
      const bloqueado = input.dataset.bloqueado === 'true';

      // --- Botón visible con el valor ---
      const raiz = el('div', 'fecha');
      const boton = el('button', 'field fecha-boton');
      boton.type = 'button';
      boton.setAttribute('aria-haspopup', 'dialog');
      boton.setAttribute('aria-expanded', 'false');
      const valor = el('span', 'fecha-valor');
      boton.append(valor);
      boton.insertAdjacentHTML('beforeend', '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>');
      if (bloqueado) boton.disabled = true;

      // --- Panel: calendario + hora ---
      const panel = el('div', 'fecha-panel');
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-label', 'Elegir fecha y hora');
      panel.hidden = true;
      const cabecera = el('div', 'fecha-cabecera');
      const anterior = el('button', 'fecha-nav', '‹'); anterior.type = 'button'; anterior.setAttribute('aria-label', 'Mes anterior');
      const siguiente = el('button', 'fecha-nav', '›'); siguiente.type = 'button'; siguiente.setAttribute('aria-label', 'Mes siguiente');
      const tituloMes = el('span', 'fecha-mes');
      cabecera.append(anterior, tituloMes, siguiente);
      const semana = el('div', 'fecha-semana');
      SEMANA.forEach((d) => semana.append(el('span', '', d)));
      const dias = el('div', 'fecha-dias');
      const hora = el('div', 'fecha-hora');
      const selHora = crearSelect('Hora');
      const selMin = crearSelect('Minuto');
      for (let h = 0; h < 24; h++) selHora.append(opcion(dd(h), dd(h)));
      for (let m = 0; m < 60; m++) selMin.append(opcion(dd(m), dd(m)));
      selHora.value = dd(estado.hora);
      selMin.value = dd(estado.min);
      hora.append(el('span', 'fecha-etiqueta', 'Hora'), selHora, el('span', 'fecha-dos-puntos', ':'), selMin);
      const listo = el('button', 'btn-primary mt-3 w-full !py-3 text-[13px]', 'Listo'); listo.type = 'button';
      panel.append(cabecera, semana, dias, hora, listo);
      raiz.append(boton, panel);
      input.insertAdjacentElement('afterend', raiz);

      const escribir = () => {
        input.value = `${estado.anio}-${dd(estado.mes)}-${dd(estado.dia)}T${dd(estado.hora)}:${dd(estado.min)}`;
        input.dispatchEvent(new Event('change', { bubbles: true }));
        valor.textContent = `${dd(estado.dia)} ${MESES[estado.mes - 1]} ${estado.anio} · ${dd(estado.hora)}:${dd(estado.min)}`;
      };

      const pintarDias = () => {
        tituloMes.textContent = `${MESES_LARGO[vista.mes - 1]} ${vista.anio}`;
        dias.innerHTML = '';
        const huecos = primerDiaSemana(vista.mes, vista.anio);
        for (let i = 0; i < huecos; i++) dias.append(el('span', 'fecha-dia vacio'));
        const total = diasEnMes(vista.mes, vista.anio);
        for (let d = 1; d <= total; d++) {
          const b = el('button', 'fecha-dia', String(d));
          b.type = 'button';
          if (vista.anio === hoy.getFullYear() && vista.mes === hoy.getMonth() + 1 && d === hoy.getDate()) b.classList.add('es-hoy');
          if (vista.anio === estado.anio && vista.mes === estado.mes && d === estado.dia) {
            b.classList.add('elegido');
            b.setAttribute('aria-current', 'date');
          }
          b.addEventListener('click', () => {
            estado.anio = vista.anio; estado.mes = vista.mes; estado.dia = d;
            // Marcar en sitio, sin redibujar la grilla: si se redibuja, el botón tocado queda fuera
            // del DOM y el detector de "clic afuera" (abajo) cerraría el panel en cada toque.
            dias.querySelectorAll('.fecha-dia.elegido').forEach((x) => { x.classList.remove('elegido'); x.removeAttribute('aria-current'); });
            b.classList.add('elegido');
            b.setAttribute('aria-current', 'date');
            escribir();
          });
          dias.append(b);
        }
      };

      const moverMes = (delta: number) => {
        let m = vista.mes + delta, a = vista.anio;
        if (m < 1) { m = 12; a--; }
        if (m > 12) { m = 1; a++; }
        vista = { anio: a, mes: m };
        pintarDias();
      };
      anterior.addEventListener('click', () => moverMes(-1));
      siguiente.addEventListener('click', () => moverMes(1));
      selHora.addEventListener('change', () => { estado.hora = Number(selHora.value); escribir(); });
      selMin.addEventListener('change', () => { estado.min = Number(selMin.value); escribir(); });

      const abrir = () => {
        cerrarTodos();
        vista = { anio: estado.anio, mes: estado.mes };
        pintarDias();
        panel.hidden = false;
        boton.setAttribute('aria-expanded', 'true');
      };
      const cerrar = () => { panel.hidden = true; boton.setAttribute('aria-expanded', 'false'); };
      boton.addEventListener('click', () => (panel.hidden ? abrir() : cerrar()));
      listo.addEventListener('click', () => { cerrar(); boton.focus(); });
      document.addEventListener('click', (e) => {
        const t = e.target as Node;
        if (!panel.hidden && t.isConnected && !raiz.contains(t)) cerrar();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { cerrar(); boton.focus(); } });

      escribir(); // deja el input sincronizado desde ya, así "required" nunca lo bloquea por vacío
    });
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:page-load', setupCamposFecha);
</script>
