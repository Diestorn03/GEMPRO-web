---
import { qrPngCacheado } from '../../lib/qr';
import Panel from '../../layouts/Panel.astro';
import { estaAutenticado } from '../../lib/auth';
import { sb } from '../../lib/supabase';
import { eventoAbierto } from '../../lib/evento';

export const prerender = false;

if (!estaAutenticado(Astro.cookies)) return Astro.redirect('/entrar', 303);

const [{ data: config }, { count }] = await Promise.all([
  sb().from('evento_config').select('*').eq('id', true).maybeSingle(),
  sb().from('registro_evento').select('*', { count: 'exact', head: true }),
]);
const guardado = Astro.url.searchParams.get('guardado');

const urlEvento = `${Astro.url.origin}/evento`;
const qrVista = 'data:image/png;base64,' + (await qrPngCacheado(urlEvento, 'gempro', 480)).toString('base64');

const aFecha = (iso: string | null) => (iso ? new Date(iso).toISOString().slice(0, 16) : '');
const forzarActual = config?.forzar_abierto === true ? 'abierto' : config?.forzar_abierto === false ? 'cerrado' : 'auto';
const abierto = eventoAbierto(config);
---
<Panel title="Evento" seccion="evento" eyebrow="Registro por QR" encabezado="El evento, con un código." descripcion="La gente escanea el QR, deja nombre, correo y teléfono, y queda en la lista para la rifa y para futuras comunicaciones de GEMPRO.">
  <span slot="acciones" class:list={['inline-flex items-center gap-2 rounded-full border px-4 py-2 text-[12px] font-bold uppercase tracking-[0.1em]', abierto ? 'border-neon/50 text-neon' : 'border-amber/50 text-amber']}>
    <span class:list={['h-2 w-2 rounded-full', abierto ? 'bg-neon' : 'bg-amber']} aria-hidden="true"></span>{abierto ? 'Registro abierto' : 'Registro cerrado'}
  </span>

  {guardado === '1' && <p class="mb-6 rounded-md border border-neon/40 bg-neon/10 px-4 py-3 text-[14px] text-white" data-reveal="fade">Configuración guardada.</p>}

  <div class="grid min-w-0 gap-6 lg:grid-cols-[1fr_340px]" data-reveal-group data-stagger="0.1">
    <div class="grid min-w-0 gap-6">
      <form method="post" action="/api/panel/evento" data-ajax class="grid min-w-0 gap-4 rounded-md border border-white/10 bg-panel p-6 sm:grid-cols-2 lg:p-8">
        <div class="sm:col-span-2"><span class="eyebrow">Apertura y cierre</span><h2 class="display mt-2 text-[24px] text-white">Fechas y control manual</h2></div>
        <div class="min-w-0">
          <label class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog" for="inicio">Abre</label>
          <input type="datetime-local" name="inicio" id="inicio" value={aFecha(config?.inicio ?? null)} class="field w-full min-w-0" />
        </div>
        <div class="min-w-0">
          <label class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog" for="fin">Cierra</label>
          <input type="datetime-local" name="fin" id="fin" value={aFecha(config?.fin ?? null)} class="field w-full min-w-0" />
        </div>
        <div class="sm:col-span-2">
          <label class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.08em] text-fog" for="forzar">Interruptor manual</label>
          <select name="forzar" id="forzar" class="field">
            <option value="auto" selected={forzarActual === 'auto'}>Automático según las fechas de arriba</option>
            <option value="abierto" selected={forzarActual === 'abierto'}>Forzar abierto (ignora las fechas)</option>
            <option value="cerrado" selected={forzarActual === 'cerrado'}>Forzar cerrado (ignora las fechas)</option>
          </select>
        </div>
        <button type="submit" class="btn-primary self-start sm:col-span-2" data-magnetic>Guardar</button>
      </form>

      <div class="rounded-md border border-white/10 bg-panel p-6 lg:p-8">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div>
            <span class="eyebrow">Participantes</span>
            <h2 class="display mt-1 text-[40px] leading-none text-neon tabular-nums" data-count={count ?? 0}>{count ?? 0}</h2>
          </div>
          <div class="flex gap-2">
            <button type="button" id="btn-csv" class="btn-ghost border border-white/15 px-4 py-2 text-[13px]">Exportar CSV</button>
            <button type="button" id="btn-ganador" class="btn-primary px-4 py-2 text-[13px]">Elegir ganador</button>
          </div>
        </div>
        <p id="resultado-ganador" class="hidden rounded-md border border-neon/40 bg-neon/10 px-4 py-3 text-[15px] text-white"></p>
      </div>
    </div>

    <div class="flex flex-col items-center gap-3 rounded-md border border-white/10 bg-panel p-6">
      <span class="eyebrow self-start">Código QR</span>
      <img src={qrVista} alt="QR del registro del evento con el logo de GEMPRO al centro" class="w-full max-w-[320px] rounded" />
      <p class="break-all text-center font-mono text-[12px] text-neon">{urlEvento}</p>
      <div class="grid w-full grid-cols-2 gap-2">
        <a href="/api/panel/qr?formato=png&estilo=gempro" class="btn-primary px-3 py-2.5 text-center text-[12px]">PNG estilo GEMPRO</a>
        <a href="/api/panel/qr?formato=svg&estilo=gempro" class="btn-primary px-3 py-2.5 text-center text-[12px]">SVG estilo GEMPRO</a>
        <a href="/api/panel/qr?formato=png&estilo=clasico" class="btn-ghost border border-white/15 px-3 py-2.5 text-center text-[12px]">PNG clásico</a>
        <a href="/api/panel/qr?formato=svg&estilo=clasico" class="btn-ghost border border-white/15 px-3 py-2.5 text-center text-[12px]">SVG clásico</a>
      </div>
      <p class="text-center text-[12px] leading-relaxed text-mist">PNG de 2400 px (20 cm a 300 dpi) y SVG vectorial para imprenta a cualquier tamaño. El clásico es la versión de máxima compatibilidad por si algún lector viejo no lee el estilizado.</p>
    </div>
  </div>
</Panel>

<script>
  function setup() {
    const btnCsv = document.getElementById('btn-csv') as HTMLButtonElement | null;
    const btnGanador = document.getElementById('btn-ganador') as HTMLButtonElement | null;
    const resultado = document.getElementById('resultado-ganador');
    if (!btnCsv || !btnGanador || !resultado || btnCsv.dataset.listo) return;
    btnCsv.dataset.listo = '1';

    async function traerRegistros() {
      const res = await fetch('/api/panel/evento');
      return res.json();
    }

    btnCsv.addEventListener('click', async () => {
      const registros = await traerRegistros();
      const filas = [['Nombre', 'Correo', 'Teléfono', 'Fecha'], ...registros.map((r: any) => [r.nombre, r.correo, r.telefono ?? '', r.creado_en])];
      const csv = filas.map((f) => f.map((v: string) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'registro-evento-gempro.csv';
      a.click();
    });

    btnGanador.addEventListener('click', async () => {
      const registros = await traerRegistros();
      if (!registros.length) { resultado.textContent = 'Todavía no hay registros.'; resultado.classList.remove('hidden'); return; }
      const ganador = registros[Math.floor(Math.random() * registros.length)];
      resultado.textContent = `🎉 Ganador: ${ganador.nombre} — ${ganador.correo}`;
      resultado.classList.remove('hidden');
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
