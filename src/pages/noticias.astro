---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { noticias } from '../data/site';
import fotoNoticias from '../assets/img/hero-slide-3.jpg';
---
<Base title="Noticias" description="Artículos técnicos de GEMPRO sobre mantenimiento predictivo, proactivo y preventivo, escritos por el mismo equipo que hace el diagnóstico en planta.">
  <section class="relative isolate overflow-hidden bg-ink pb-16 pt-36 lg:pb-20 lg:pt-52" data-parallax-scope>
    <div class="absolute inset-0 -z-20" data-parallax="12">
      <Image src={fotoNoticias} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="h-full w-full object-cover" loading="eager" />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(6,20,38,.96)_0%,rgba(6,20,38,.82)_55%,rgba(6,20,38,.55)_100%)]" aria-hidden="true"></div>
    <div class="container-x flex flex-col gap-4">
      <span class="eyebrow" data-reveal="fade">Noticias</span>
      <h1 class="display max-w-[900px] text-[clamp(40px,7vw,84px)] text-white" data-split>Lo que aprendemos midiendo, lo compartimos.</h1>
      <p class="max-w-[640px] text-[17px] leading-relaxed text-fog lg:text-[19px]" data-reveal data-delay="0.3">Artículos cortos sobre lo que vemos en planta, escritos por el mismo equipo que hace el diagnóstico.</p>
    </div>
  </section>

  <section class="container-x grid gap-5 py-16 sm:grid-cols-2 lg:grid-cols-3 lg:py-24" data-reveal-group data-stagger="0.1">
    {noticias.map((n) => (
      <a href={n.href} class="group flex flex-col gap-3 rounded-md border border-white/10 bg-panel p-6 transition-[border-color,transform] duration-500 hover:-translate-y-1.5 hover:border-neon/50">
        <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-neon">
          <span>{n.tag}</span><span class="text-mist">·</span><span class="text-mist">{n.fecha}</span>
        </div>
        <h2 class="display text-[22px] text-white">{n.title}</h2>
        <p class="text-[14px] leading-relaxed text-mist">{n.extracto}</p>
        <span class="mt-1 inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.08em] text-white transition-colors group-hover:text-neon">
          Leer más
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    ))}
  </section>

  <Contact />
</Base>
