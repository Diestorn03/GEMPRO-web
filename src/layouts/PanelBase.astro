---
/**
 * Cascarón del panel privado, el portal de clientes, el login y la página del evento: mismo
 * lenguaje visual del sitio público (tokens, tipografía, sistema de movimiento GSAP y
 * transiciones entre páginas), pero sin el Nav/Footer/MobileBar de mercadeo.
 *
 * <ClientRouter /> es necesario: el sistema de movimiento (scripts/motion.ts) y los scripts
 * de cada página arrancan con `astro:page-load`, que Astro solo dispara cuando el router de
 * cliente está presente. Sin él, el panel se veía estático.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { Image } from 'astro:assets';
import logoBlanco from '../assets/logos/logo-gempro-blanco.png';
import { site } from '../data/site';
import BarraCarga from '../components/BarraCarga.astro';

interface Props { title?: string }
const { title } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html lang="es" class="js" data-scroll-nativo>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#061426" />
    <script is:inline>
      setTimeout(function () { document.documentElement.classList.add('motion-ready'); }, 2500);
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-ink">
    <BarraCarga />
    <!-- Fondo: malla técnica muy sutil, como la del sitio -->
    <div class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(40,175,96,.08),transparent_55%)]" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 -z-10 opacity-[.35] [background-image:linear-gradient(rgba(255,255,255,.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.035)_1px,transparent_1px)] [background-size:48px_48px]" aria-hidden="true"></div>

    <header class="sticky top-0 z-40 border-b border-white/10 bg-ink/85 backdrop-blur-md">
      <div class="container-x flex flex-wrap items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center" aria-label="GEMPRO, inicio">
          <Image src={logoBlanco} alt="GEMPRO" height={40} width={156} class="h-8 w-auto" />
        </a>
        <slot name="nav" />
      </div>
    </header>
    <main class="container-x py-10 lg:py-14">
      <slot />
    </main>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<script>
  /**
   * Los formularios del panel/portal (marcados con data-ajax) se envían por fetch en vez de
   * como navegación nativa del navegador. Se detectó que, en una página que se llegó siguiendo
   * la redirección de OTRO formulario (p. ej. justo después de entrar con la contraseña), el
   * envío nativo del SIGUIENTE formulario en esa misma pestaña degrada de POST a GET en algunos
   * navegadores (reproducido incluso en la compilación de producción) — un comportamiento del
   * navegador ante cadenas de redirección tras un POST, no un error del servidor. fetch() no
   * tiene ese problema.
   */
  function setupAjaxForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-ajax]').forEach((form) => {
      if (form.dataset.ajaxListo) return;
      form.dataset.ajaxListo = '1';
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (form.dataset.confirmar && !confirm(form.dataset.confirmar)) return;
        const boton = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (boton) { boton.disabled = true; boton.dataset.texto = boton.textContent || ''; boton.textContent = 'Un momento…'; }
        try {
          const res = await fetch(form.action, { method: form.method || 'post', body: new FormData(form), headers: { 'X-Peticion-Ajax': '1' } });
          location.href = res.headers.get('X-Redirigir') || res.url;
        } catch {
          if (boton) { boton.disabled = false; boton.textContent = boton.dataset.texto || 'Enviar'; }
          alert('No se pudo procesar la solicitud. Intenta de nuevo.');
        }
      });
    });
  }
  document.addEventListener('astro:page-load', setupAjaxForms);
</script>
