---
/**
 * Cascarón mínimo para el panel privado y el portal de clientes: mismos tokens de color y
 * tipografía del sitio público, pero SIN el Nav/Footer/MobileBar de mercadeo (no tiene sentido
 * mostrarle "Servicios, Productos, Noticias" a alguien que ya entró con contraseña).
 */
import '../styles/global.css';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { Image } from 'astro:assets';
import logoBlanco from '../assets/logos/logo-gempro-blanco.png';
import { site } from '../data/site';

interface Props { title?: string }
const { title } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#061426" />
  </head>
  <body class="min-h-dvh bg-ink">
    <header class="border-b border-white/10">
      <div class="container-x flex flex-wrap items-center justify-between gap-4 py-5">
        <a href="/" class="flex items-center" aria-label="GEMPRO, inicio">
          <Image src={logoBlanco} alt="GEMPRO" height={40} width={156} class="h-8 w-auto" />
        </a>
        <slot name="nav" />
      </div>
    </header>
    <main class="container-x py-10">
      <slot />
    </main>
  </body>
</html>

<script>
  /**
   * Los formularios del panel/portal (marcados con data-ajax) se envían por fetch en vez de
   * como navegación nativa del navegador. Se detectó que, en una página que se llegó siguiendo
   * la redirección de OTRO formulario (p. ej. justo después de entrar con la contraseña), el
   * envío nativo del SIGUIENTE formulario en esa misma pestaña degrada de POST a GET en algunos
   * navegadores (reproducido incluso en la compilación de producción, sin nada de Astro dev de
   * por medio) — un comportamiento del navegador ante cadenas de redirección tras un POST, no
   * un error del servidor. fetch() no tiene ese problema, así que se usa para todos los
   * formularios de esta sección en vez de depender de la navegación nativa.
   */
  function setupAjaxForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-ajax]').forEach((form) => {
      if (form.dataset.ajaxListo) return;
      form.dataset.ajaxListo = '1';
      form.addEventListener('submit', async (ev) => {
        if (form.dataset.confirmar && !confirm(form.dataset.confirmar)) { ev.preventDefault(); return; }
        ev.preventDefault();
        const boton = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (boton) boton.disabled = true;
        try {
          const res = await fetch(form.action, { method: form.method || 'post', body: new FormData(form) });
          location.href = res.url;
        } catch {
          if (boton) boton.disabled = false;
          alert('No se pudo procesar la solicitud. Intenta de nuevo.');
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', setupAjaxForms);
  if (document.readyState !== 'loading') setupAjaxForms();
</script>
